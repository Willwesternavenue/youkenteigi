    "iron-session": "^8.0.4",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.4",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "pdfmake": "^0.3.9",
    "postgres": "^3.4.9",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.10.0",
